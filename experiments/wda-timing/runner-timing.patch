@@ -7,12 +7,52 @@
  */
 
 #import "FBTouchActionCommands.h"
+#import "../Utilities/IMInputTiming.h"
 
 #import "FBRoute.h"
 #import "FBRouteRequest.h"
 #import "FBSession.h"
 #import "XCUIApplication+FBTouchAction.h"
 
+static NSString *const IMTimingKey = @"iMirror.InputTiming";
+@implementation IMInputTiming {
+  NSLock *_lock;
+  NSMutableDictionary<NSString *, NSNumber *> *_marks;
+  NSTimeInterval _origin;
+}
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    _lock = [NSLock new];
+    _marks = [NSMutableDictionary new];
+    _origin = NSProcessInfo.processInfo.systemUptime;
+  }
+  return self;
+}
+- (void)mark:(NSString *)stage {
+  NSTimeInterval elapsed = (NSProcessInfo.processInfo.systemUptime - _origin) * 1000.0;
+  [_lock lock];
+  _marks[stage] = @(elapsed);
+  [_lock unlock];
+}
+- (NSDictionary *)snapshot {
+  [_lock lock];
+  NSDictionary *copy = _marks.copy;
+  [_lock unlock];
+  return copy;
+}
+@end
+IMInputTiming *IMCurrentInputTiming(void) {
+  return NSThread.currentThread.threadDictionary[IMTimingKey];
+}
+void IMSetInputTiming(IMInputTiming *timing) {
+  if (timing) {
+    NSThread.currentThread.threadDictionary[IMTimingKey] = timing;
+  } else {
+    [NSThread.currentThread.threadDictionary removeObjectForKey:IMTimingKey];
+  }
+}
