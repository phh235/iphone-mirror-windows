+  IMInputTiming *previous = IMCurrentInputTiming();
+  IMInputTiming *timing = [IMInputTiming new];
+  IMSetInputTiming(timing);
+  @try {
+    [timing mark:@"handler_start"];
+    XCUIApplication *application = request.session.activeApplication;
+    [timing mark:@"active_application_ready"];
+    NSArray *actions = (NSArray *)request.arguments[@"actions"];
+    NSError *error;
+    // Same validation/synthesizer/idle policy as the pinned standard route.
+    if (![application fb_performW3CActions:actions elementCache:request.session.elementCache error:&error]) {
+      return FBResponseWithUnknownError(error);
+    }
+    [timing mark:@"handler_complete"];
+    return FBResponseWithObject(@{
+      @"imirror_timing_ms": timing.snapshot,
+      @"scope": @"Handler-relative monotonic time. Excludes HTTP parsing before routing, response transmission and display latency."
+    });
+  } @finally {
+    IMSetInputTiming(previous);
+  }
+}
