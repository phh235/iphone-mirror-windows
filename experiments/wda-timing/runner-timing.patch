+++ b/WebDriverAgentLib/Utilities/IMInputTiming.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// iMirror experimental runner timing. No input contents or identifiers are stored.
+#import <Foundation/Foundation.h>
+
+@interface IMInputTiming : NSObject
+- (void)mark:(NSString *)stage;
+- (NSDictionary *)snapshot;
+@end
+
+FOUNDATION_EXPORT IMInputTiming *IMCurrentInputTiming(void);
+FOUNDATION_EXPORT void IMSetInputTiming(IMInputTiming *timing);
