#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @IPHONEMIRROR_FILE_VERSION@
 PRODUCTVERSION @IPHONEMIRROR_FILE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RayrenSX\0"
            VALUE "FileDescription", "iPhoneMirror USB Capture Core\0"
            VALUE "FileVersion", "@IPHONEMIRROR_FILE_VERSION@\0"
            VALUE "InternalName", "iPhoneMirror.Core.dll\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 RayrenSX\0"
            VALUE "OriginalFilename", "iPhoneMirror.Core.dll\0"
            VALUE "ProductName", "iPhoneMirror\0"
            VALUE "ProductVersion", "@IPHONEMIRROR_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
